# Copy to .env.local and fill in what you use — opposable loads it automatically.
#   cp .env.example .env.local
# Precedence: real environment variables > .env.local > .env

# Anthropic (default provider)
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Any OpenAI-compatible endpoint (OpenAI, vLLM, Ollama, ...)
# Setting OPPOSABLE_BASE_URL switches the provider; OPENAI_API_KEY is the bearer token.
#OPPOSABLE_BASE_URL=http://localhost:11434/v1
#OPENAI_API_KEY=sk-...

# Default model (same as --model)
#OPPOSABLE_MODEL=claude-sonnet-4-6
