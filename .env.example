# Copy to .env.local and fill in what you use — opposable loads it automatically.
#   cp .env.example .env.local
# Precedence: real environment variables > .env.local > .env

# Anthropic (default provider)
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Any OpenAI-compatible endpoint (OpenAI, vLLM, Ollama, ...)
# Setting OPPOSABLE_BASE_URL switches the provider; OPENAI_API_KEY is the bearer token.
#OPPOSABLE_BASE_URL=http://localhost:11434/v1
#OPENAI_API_KEY=sk-...

# Default model (same as --model)
#OPPOSABLE_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------------------
# Hosted deployment
#
# Nothing below matters for a laptop install. OPPOSABLE_HOSTED=1 turns on the
# multi-tenant rules, and `opposable serve` then refuses to start until every
# ship-blocker below is configured — see docs/plan-stage0.md. Run it once with
# the flag set and it will tell you exactly what is missing.
# ---------------------------------------------------------------------------

#OPPOSABLE_HOSTED=1

# Auth without the rest of hosted mode: for a self-hoster exposing the server
# beyond localhost who still wants accounts.
#OPPOSABLE_AUTH=1

# Origins. The files origin MUST be a separate registrable domain, not a
# subdomain — an agent that writes report.html is writing a page.
#OPPOSABLE_APP_ORIGIN=https://opposable.example
#OPPOSABLE_FILES_ORIGIN=https://opposableusercontent.example
#OPPOSABLE_FILE_SIGNING_KEY=  # >=32 bytes of randomness

# Sandbox. local and docker are development-only and hosted mode refuses them.
#OPPOSABLE_SANDBOX_BACKEND=       # a microVM backend, once one is chosen
#OPPOSABLE_DOCKER_PROFILE=hardened     # or `permissive` — root + writable /,
                                       # which is what `apt-get install` needs
#OPPOSABLE_DOCKER_NETWORK=             # an isolated network whose only route
                                       # out is the allowlist proxy
#OPPOSABLE_DOCKER_STORAGE_SIZE=        # overlay2 ignores this; opt-in only

# Egress. Default-deny: an empty allowlist in hosted mode reaches nothing.
#OPPOSABLE_EGRESS_PROXY=http://egress-proxy.internal:3128
#OPPOSABLE_ALLOWED_HOSTS=example.com,docs.example.com
#OPPOSABLE_DENIED_CIDRS=10.0.0.0/8     # our own VPC, belt to the braces of
                                       # running sandboxes in another account

# Client-settable parameters are allowlisted. An empty base-url allowlist
# means clients cannot name an endpoint at all, which is the safe default:
# a client-chosen base_url receives our Authorization header.
#OPPOSABLE_ALLOWED_MODELS=claude-sonnet-5,claude-haiku-4-5-20251001
#OPPOSABLE_ALLOWED_BASE_URLS=
#OPPOSABLE_ALLOWED_IMAGES=ubuntu:24.04

# Secrets. The local-file store is development-only: fine for your own key,
# disqualifying for anyone else's.
#OPPOSABLE_SECRET_STORE=env

# Signup ladder and legal.
#OPPOSABLE_TURNSTILE_SECRET=
#OPPOSABLE_MAIL_PROVIDER=
#OPPOSABLE_DISPOSABLE_DOMAINS=         # extends the built-in list
#OPPOSABLE_TERMS_VERSION=2026-07-31    # must match docs/legal/TERMS.md
